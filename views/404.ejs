<!DOCTYPE html>
<html lang="en">
    <%- include('partials/head') %>
    <body>
        <%- include('partials/header', { headerMode: 'default' }) %>

        <div id="page-content">
            <div class="form-container" style="text-align: center; margin: 4rem auto;">
                <span class="eyebrow-label">404</span>
                <h1 style="margin: 0.5rem 0;">Page Not Found</h1>
                <p style="margin-bottom: 1.5rem;">
                    <%= typeof errorMessage !== 'undefined' ? errorMessage : `We could not find "${requestedPath}".` %>
                </p>
                <div style="display: flex; gap: 0.75rem; justify-content: center;">
                    <a href="/" class="button-primary">Back to Home</a>
                    <a href="/browse" class="button-secondary">Browse Items</a>
                </div>
            </div>
        </div>

        <%- include('partials/footer') %>
    </body>
</html>
