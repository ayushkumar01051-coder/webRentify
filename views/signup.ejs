<!DOCTYPE html>
<html lang="en">
    <%- include('partials/head') %>
    <body class="login-page-body">
        <%- include('partials/header', { headerMode: 'minimal' }) %>

        <div id="page-content" class="login-main">
            <div id="signup-form-div">
                <div class="form-container login-container">
                    <h2>Create Your Account</h2>
                    <p class="auth-subtext">Join the Rentify community to rent gear, list items, and post verified reviews.</p>

                    <div class="social-signup-options">
                        <a href="#" class="social-button">
                            <span class="material-symbols-outlined social-icon">mail</span>
                            <span>Sign up with Google</span>
                        </a>
                        <a href="#" class="social-button">
                            <span class="material-symbols-outlined social-icon">window</span>
                            <span>Sign up with Microsoft</span>
                        </a>
                    </div>

                    <div class="divider">
                        <span>OR</span>
                    </div>

                    <div id="auth-feedback" class="form-feedback"></div>

                    <form id="signup-form">
                        <div class="form-group">
                            <label for="signup-name">Full Name *</label>
                            <input type="text" id="signup-name" placeholder="Enter your full name">
                        </div>
                        <div class="form-group">
                            <label for="signup-email">Email Address *</label>
                            <input type="email" id="signup-email" placeholder="you@example.com">
                        </div>
                        <div class="form-group">
                            <label for="signup-city">City / Neighborhood *</label>
                            <input type="text" id="signup-city" placeholder="e.g. Gurgaon">
                        </div>
                        <div class="form-group">
                            <label for="signup-password">Password (min 6 characters) *</label>
                            <input type="password" id="signup-password" placeholder="Enter a secure password">
                        </div>
                        <div class="form-group">
                            <label class="checkbox-label small-text">
                                <input type="checkbox" id="signup-terms"> I agree to the Rentify Terms &amp; Privacy Policy.
                            </label>
                        </div>
                        <div class="form-group">
                            <button type="submit" class="button-primary full-width-button">Create Account &amp; Save JSON</button>
                        </div>
                    </form>
                </div>

                <p class="form-footer-text">
                    Already have an account? <a href="/login">Sign In</a>
                </p>
            </div>
        </div>

        <script src="/js/auth.js"></script>
    </body>
</html>
